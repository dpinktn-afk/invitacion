# Vercel + Supabase
# El proyecto acepta los nombres automáticos de la integración de Vercel:
invitacionVL_SUPABASE_URL=https://tu-proyecto.supabase.co
invitacionVL_SUPABASE_SECRET_KEY=sb_secret_REEMPLAZA_CON_TU_NUEVA_CLAVE
# Alternativa legacy si tu integración solo proporciona service_role:
# invitacionVL_SUPABASE_SERVICE_ROLE_KEY=REEMPLAZA_CON_TU_NUEVA_SERVICE_ROLE

# Elige un PIN privado para el panel/acciones administrativas
ADMIN_PIN=CAMBIA_ESTE_PIN

# También son compatibles estos nombres genéricos para desarrollo local:
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=...
